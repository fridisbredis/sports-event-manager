# Supabase — get these from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Twilio — get these from console.twilio.com
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+46xxxxxxxxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry — get the DSN from Settings > Client Keys (DSN) in your Sentry project.
# Same DSN for both client and server; NEXT_PUBLIC_SENTRY_DSN is inlined into
# the browser bundle at build time, SENTRY_DSN stays server-only.
# Leave both unset locally — Sentry no-ops without a DSN.
#
# If you DO fill in a DSN locally (to check that reporting works), set
# SENTRY_ENVIRONMENT too. It is unset here, so sentry.server.config.ts falls
# back to NODE_ENV — which `next dev` with Turbopack reports as "production",
# so local errors land in the dev Sentry project tagged as prod errors. The
# deploy workflows set it explicitly (development / production); nothing sets
# it locally. Seen for real on 2026-08-27 during rehearsal Del 3.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# SENTRY_ENVIRONMENT=local
# Only needed in CI, for uploading source maps — leave unset locally.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
