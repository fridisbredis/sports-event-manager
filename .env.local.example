# Supabase — get these from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Twilio — get these from console.twilio.com
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+46xxxxxxxxx

# Local Supabase auth — supabase/config.toml enables [auth.sms.twilio] with
# dummy account/service SIDs so GoTrue's local phone-auth check passes
# ("phone_provider_disabled" if the provider block is disabled). No real SMS
# is sent locally: [auth.sms.test_otp] intercepts the seeded test numbers
# before Twilio would be called. Any non-empty string works here.
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=dummy-local-token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry — get the DSN from Settings > Client Keys (DSN) in your Sentry project.
# Same DSN for both client and server; NEXT_PUBLIC_SENTRY_DSN is inlined into
# the browser bundle at build time, SENTRY_DSN stays server-only.
# Leave both unset locally — Sentry no-ops without a DSN.
#
# If you DO fill in a DSN locally (to check that reporting works), set
# SENTRY_ENVIRONMENT too. It is unset here, so sentry.server.config.ts falls
# back to NODE_ENV — which `next dev` with Turbopack reports as "production",
# so local errors land in the dev Sentry project tagged as prod errors. The
# deploy workflows set it explicitly (development / production); nothing sets
# it locally. Seen for real on 2026-08-27 during rehearsal Del 3.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# SENTRY_ENVIRONMENT=local
# Only needed in CI, for uploading source maps — leave unset locally.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Cron — shared secret guarding the scheduled route handlers
# (api/cron/sms-worker and api/cron/gdpr-warning, SEC-09). They take it as
# `Authorization: Bearer <secret>` and fail closed with 401 when it is unset,
# so leaving this blank does not expose them — it just means you cannot invoke
# them locally. Any random string works locally. In dev and prod the same value
# lives in two places and must match: the app gets it as a container env var
# from the GitHub secret (`CRON_SECRET` / `PROD_CRON_SECRET`), and pg_cron reads
# its own copy from the Supabase Vault to make the call — see migration 0029.
# Test with:
#   curl -X POST http://localhost:3000/api/cron/sms-worker \
#     -H "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
