# Config for the PERF-01 volume scripts (scripts/seed-perf.ts, seed-perf-clean.ts).
#
#   cp .env.perf.example .env.perf
#
# These scripts deliberately do NOT read .env.local. That file points at the dev
# cloud project — which is correct for running the app locally against dev data,
# but wrong for a script that writes ~1000 assignments and ~90 auth users. Those
# belong in a throwaway local stack, never in the environment colleagues test
# against.
#
# The values below are the Supabase CLI's fixed local defaults. They are the
# same on every machine, are not secrets, and work as-is once `supabase start`
# is running — which is why this file can be committed while .env.perf is not.
#
# The names carry a PERF_ prefix on purpose: pasting a cloud config in here will
# fail with a clear error rather than silently satisfying the script.
#
# Only loopback hosts are accepted. There is no flag to widen that.

PERF_SUPABASE_URL=http://127.0.0.1:54321
PERF_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# The measurement harness signs in as seeded users, which needs the anon key.
PERF_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Base URL of the running app under measurement. Use `next build && next start`,
# never `next dev` — dev-mode compilation happens on first request and would
# land entirely in the p95 tail.
PERF_APP_URL=http://127.0.0.1:3000
